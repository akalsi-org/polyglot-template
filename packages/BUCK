# In-graph assembly from packages/catalog.bzl, the single package authority.
# dbg is the default
# profile, like every other already-ported lane's macros; select opt with
# `--target-platforms //config:<native-target>-opt` (as `repo.sh package`
# does). `-m //config:opt` cannot override these targets' default platform.
#
# The generic package() rule takes `deps`. Each producing target owns its
# staged entries. The Python target also carries its Python library closure.

load("//packages:catalog.bzl", "package_by_name")
load("//rules:file.bzl", "export_file")
load("//rules:package.bzl", "package", "package_manifest_test", "package_smoke")

export_file(
  name = "catalog.bzl",
  src = "catalog.bzl",
  visibility = ["PUBLIC"],
)

package(
  name = "polyglot-demo",
  version = package_by_name("polyglot-demo")["version"],
  deps = [
    "//go/app/hello:hello",
    "//python/app/hello:hello",
    "//tsweb:site",
  ],
  visibility = ["PUBLIC"],
)

package_smoke(
  name = "polyglot-demo-smoke",
  package = ":polyglot-demo",
  commands = {
    "bin/go-hello": [],
    "bin/python-hello": [],
    "bin/python": ["--version"],
    "bin/python3": ["--version"],
  },
  smoke_script = "//:tsweb_smoke.py",
  visibility = ["PUBLIC"],
)

# Deno server-app packaging lane: ts/app/server:server's own transitive
# DenoSourcesInfo closure (main.ts + //ts/lib/greeting:greeting) staged
# under ts/ (a root-level sibling of bin/lib/libexec/runtime/share), plus
# the pinned deno binary and a generated launcher - see rules/deno.bzl's
# deno_app and rules/package.bzl's "deno-app-launcher" kind handler for the
# full design (zero-npm-dep apps only, for now).
package(
  name = "polyglot-server",
  version = package_by_name("polyglot-server")["version"],
  deps = ["//ts/app/server:server"],
  visibility = ["PUBLIC"],
)

package_smoke(
  name = "polyglot-server-smoke",
  package = ":polyglot-server",
  commands = {"bin/server": ["--smoke"]},
  visibility = ["PUBLIC"],
)

package_manifest_test(
  name = "manifest-validate",
  tools_lock = "//:tools.lock.toml",
  visibility = ["PUBLIC"],
)
