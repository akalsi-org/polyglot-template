# In-graph assembly of package.toml's polyglot-demo application package
# (`./repo.sh package polyglot-demo` builds the //packages target below;
# tools/package_release.py remains only the fallback for manifest-only
# packages with no buck2 target - see repo.sh's package dispatch comment).
# dbg is the default
# profile, like every other already-ported lane's macros; override with
# `-m //config:opt` to match repo.sh's own `[dbg|opt]` opt-in.
#
# Unlike the old polyglot_package rule (which took one dep attr per staged
# piece by name), the generic package() rule just takes `deps` - every
# staged entry (libexec/cpp-hello, bin/go-hello, bin/python-hello,
# python/lib/*, web, ...) is folded in transitively off these four
# app-level targets' own PackageInfo (see rules/pkg.bzl), including
# //python/app/hello:hello's own python/lib deps. bin/ names come from each
# producing target's own `pkg_name` attr (cpp/app/hello:hello,
# go/app/hello:hello, python/app/hello:hello all set one - see
# rules/{cxx,go,python}.bzl).

load("//rules:package.bzl", "package", "package_manifest_test", "package_smoke")

package(
  name = "polyglot-demo",
  version = "0.1.0",
  deps = [
    "//cpp/app/hello:hello",
    "//go/app/hello:hello",
    "//python/app/hello:hello",
    "//tsweb:site",
  ],
  visibility = ["PUBLIC"],
)

package_smoke(
  name = "polyglot-demo-smoke",
  package = ":polyglot-demo",
  commands = {
    "bin/cpp-hello": [],
    "bin/go-hello": [],
    "bin/python-hello": [],
    "bin/python": ["--version"],
    "bin/python3": ["--version"],
  },
  smoke_script = "//:tsweb_smoke.py",
  visibility = ["PUBLIC"],
)

# Deno server-app packaging lane: ts/app/server:server's own transitive
# DenoSourcesInfo closure (main.ts + //ts/lib/greeting:greeting) staged
# under ts/ (a root-level sibling of bin/lib/libexec/runtime/share), plus
# the pinned deno binary and a generated launcher - see rules/deno.bzl's
# deno_app and rules/package.bzl's "deno-app-launcher" kind handler for the
# full design (zero-npm-dep apps only, for now).
package(
  name = "polyglot-server",
  version = "0.1.0",
  deps = ["//ts/app/server:server"],
  visibility = ["PUBLIC"],
)

package_smoke(
  name = "polyglot-server-smoke",
  package = ":polyglot-server",
  commands = {"bin/server": ["--smoke"]},
  visibility = ["PUBLIC"],
)

package_manifest_test(
  name = "manifest-validate",
  lock = "//:runtime-resolution.lock.toml",
  manifest = "//:package.toml",
  tools_lock = "//:tools.lock.toml",
  visibility = ["PUBLIC"],
)
