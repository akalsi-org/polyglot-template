{
  "lock": true,
  "nodeModulesDir": "auto",
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@2.0.2",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@6.0.3",
    "react": "npm:react@19.2.7",
    "react-dom/client": "npm:react-dom@19.2.7/client",
    "vite": "npm:vite@8.1.4",
    "pyright": "npm:pyright@1.1.407",
    "nanoid": "npm:nanoid@3.3.15"
  },
  "scopes": {
    "./ts/": {
      "@/": "./ts/lib/"
    },
    "./tsweb/": {
      "#/": "./tsweb/lib/"
    }
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  },
  "fmt": {
    "include": ["ts/", "tsweb/"],
    "indentWidth": 2,
    "useTabs": false
  },
  "lint": {
    "include": ["ts/", "tsweb/"]
  },
  "test": {
    "include": ["ts/test/", "tsweb/test/"]
  }
}
