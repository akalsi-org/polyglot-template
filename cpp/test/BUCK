# Establishes cpp/test/ as a buck2 package so rules/toolchain.bzl's
# gcc_musl_toolchain can depend on reflection.cc for the C++26 reflection
# capability probe. Test executables build against the pinned gcc-musl
# toolchain and share one doctest_runner object per configuration (see
# rules/cxx.bzl's cxx_object and cxx_test).

load("//rules:cxx.bzl", "cxx_object", "cxx_test")
load("//rules:file.bzl", "export_file")

export_file(
  name = "reflection.cc",
  src = "reflection.cc",
  visibility = ["//toolchains:"],
)

cxx_object(
  name = "doctest_runner_obj",
  src = "doctest_runner.cc",
  doctest = True,
  visibility = ["//cpp/..."],
)

cxx_test(
  name = "example_test",
  srcs = ["example_test.cc"],
  deps = ["//cpp/lib/example:example"],
)

cxx_test(
  name = "example_edge_test",
  srcs = ["example_edge_test.cc"],
  deps = ["//cpp/lib/example:example"],
)

cxx_test(
  name = "pgt_core_test",
  srcs = ["core_test.cc"],
  deps = ["//cpp/lib/pgt/core:pgt_core"],
)

cxx_test(
  name = "mpsc_test",
  srcs = ["mpsc_test.cc"],
  deps = ["//cpp/lib/pgt/mpsc:mpsc"],
)

# Fork-based fault injection (killed/stopped writers, misuse death tests).
# Separate from mpsc_test so that one stays runnable under TSan.
cxx_test(
  name = "mpsc_fault_test",
  srcs = ["mpsc_fault_test.cc"],
  deps = ["//cpp/lib/pgt/mpsc:mpsc"],
)

# Variant coverage beyond Mpsc: Spsc, ShardedMpsc (K >= 2), MultiSpsc.
# Per-writer-subsequence differential, registration semantics, and the
# K >= 2 attachReader regression. Owner: impl-queue.
cxx_test(
  name = "mpsc_variants_test",
  srcs = ["mpsc_variants_test.cc"],
  deps = ["//cpp/lib/pgt/mpsc:mpsc"],
)
