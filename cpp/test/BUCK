# Establishes cpp/test/ as a buck2 package so rules/toolchain.bzl's
# gcc_musl_toolchain can depend on reflection.cc for the C++26 reflection
# capability probe. Test executables build against the pinned gcc-musl
# toolchain and share one doctest_runner object per configuration (see
# rules/cxx.bzl's cxx_object and cxx_test).

load("//rules:cxx.bzl", "cxx_object", "cxx_test")
load("//rules:file.bzl", "export_file")

export_file(
  name = "reflection.cc",
  src = "reflection.cc",
  visibility = ["//toolchains:"],
)

cxx_object(
  name = "doctest_runner_obj",
  src = "doctest_runner.cc",
  doctest = True,
  visibility = ["//cpp/..."],
)

cxx_test(
  name = "example_test",
  srcs = ["example_test.cc"],
  deps = ["//cpp/lib/example:example"],
)

cxx_test(
  name = "example_edge_test",
  srcs = ["example_edge_test.cc"],
  deps = ["//cpp/lib/example:example"],
)

cxx_test(
  name = "pgt_core_test",
  srcs = ["core_test.cc"],
  deps = ["//cpp/lib/pgt/core:pgt_core"],
)

cxx_test(
  name = "mpsc_test",
  srcs = ["mpsc_test.cc"],
  deps = ["//cpp/lib/pgt/mpsc:mpsc"],
)

# Fork-based fault injection (killed/stopped writers, misuse death tests).
# Separate from mpsc_test so that one stays runnable under TSan.
cxx_test(
  name = "mpsc_fault_test",
  srcs = ["mpsc_fault_test.cc"],
  deps = ["//cpp/lib/pgt/mpsc:mpsc"],
)

# CROSS-PROCESS fault injection: children attach by fd (or shm name) into
# fresh mappings and objects (never the parent's), then are killed, stopped,
# zombified, or forked mid-protocol. Covers writer kill/stop, zombie liveness,
# reader restart, and slot recycling gated on proven death plus a drained
# ring -- paths reachable only with real processes and real signals. Every
# break of the recovery/liveness/registry protocol was verified to make one
# of these tests fail before it was trusted to pass.
cxx_test(
  name = "mpsc_xproc_test",
  srcs = ["mpsc_xproc_test.cc"],
  deps = ["//cpp/lib/pgt/mpsc:mpsc"],
)

# Variant coverage beyond Mpsc: Spsc, ShardedMpsc (K >= 2), MultiSpsc.
# Per-writer-subsequence differential, registration semantics, and the
# K >= 2 attachReader regression. Also the affinity regimes: pinned
# one-writer-per-core for real cross-core coherence traffic, and
# oversubscribed for preemption inside the reserve-to-commit window, with an
# onContended witness asserting the run actually contended.
cxx_test(
  name = "mpsc_variants_test",
  srcs = ["mpsc_variants_test.cc"],
  deps = ["//cpp/lib/pgt/mpsc:mpsc"],
)
