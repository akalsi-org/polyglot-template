# Header-only pgt::core library (types.hh, platform.hh). Additive to the
# moon-owned cpp lane, which has no library abstraction of its own: moon's
# tools/cpp_graph.py compiles cpp/test/core_test.cc directly against
# include_dirs = ["//lib"] (see cpp/test/build.toml); this cxx_library exists
# so buck2 targets can depend on the headers instead of repeating the
# include-dir string everywhere.

load("//rules:cxx.bzl", "cxx_library")
load("//rules:file.bzl", "export_file")

export_file(
  name = "types.hh",
  src = "types.hh",
  visibility = ["//cpp/..."],
)

export_file(
  name = "platform.hh",
  src = "platform.hh",
  visibility = ["//cpp/..."],
)

cxx_library(
  name = "pgt_core",
  hdrs = [":types.hh", ":platform.hh"],
  visibility = ["//cpp/..."],
)
