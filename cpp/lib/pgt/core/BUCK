# Header-only pgt::core library (types.hh, platform.hh). hdrs stage into
# this library's own include-tree node (see rules/cxx.bzl's IncludeTreeSet
# doc comment) at the logical path this package's location implies relative
# to cpp/lib (pgt/core/types.hh, pgt/core/platform.hh) - any consumer that
# lists this target in `deps` gets that tree folded into its own -I flags
# automatically, no include_dirs or export_file needed here.

load("//rules:cxx.bzl", "cxx_library")

cxx_library(
  name = "pgt_core",
  hdrs = ["types.hh", "platform.hh"],
  visibility = ["//cpp/..."],
)
