# example.cc is compiled through the adapter mechanism (see
# cpp/adapters/BUCK), mirroring cpp/adapters/example-vendor.json, which
# treats it as third-party vendor code without its own build file. Only
# export_file() targets live here so cpp/adapters/BUCK and any consumer of
# example.hh can reference these sources across the package boundary.

load("//rules:file.bzl", "export_file")

export_file(
  name = "example.cc",
  src = "example.cc",
  visibility = ["//cpp/..."],
)

export_file(
  name = "example.hh",
  src = "example.hh",
  visibility = ["//cpp/..."],
)
