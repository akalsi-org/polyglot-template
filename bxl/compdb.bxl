"""Materializes a clang compilation database for the buck2-built cpp lane.

Walks every action under //cpp/... and //python/... via aquery, keeps the
cxx_compile ones (rules/python.bzl's py_extension reuses the same
"cxx_compile" category/action shape as rules/cxx.bzl's cxx_library/cxx_test,
so the fastbytes compile action is picked up here without any extra
filtering logic), and re-renders each as a standard {directory, file,
arguments} compdb entry. The file comes from the structured
``source=<repo-relative-path>;...`` action identifier emitted by both native
rules, not a positional command argument. `./repo.sh compile-commands` invokes this and
copies the result to the repo-root compile_commands.json (this bxl owns
that file's content; there is no other generator). Invoke directly with:

  buck2 bxl //bxl:compdb.bxl:compdb

The printed path (an ensured artifact under buck-out) is the generated
compile_commands.json for this invocation's active profile (dbg by default;
pass --target-platforms //config:<native-target>-opt to generate the opt one,
same as any other cpp lane build).
"""

def _parse_rendered_list(value: str) -> list[str]:
  # aquery's attrs.cmd.value() renders a cmd_args list as its Starlark
  # repr, "[a, b, c]" (comma-space joined); parse it back into tokens.
  #
  # This is LOSSY and cannot be made exact from here: buck2's aquery surface
  # exposes the command only as rendered display text, so any argument that
  # itself contains ", " splits into two bogus tokens with nothing to
  # distinguish it from a real separator. That is why the `file` field is
  # NOT recovered this way - it comes from the structured
  # `source=<path>;...` action identifier instead (see
  # _source_from_identifier below and the identifier contract in
  # rules/cxx.bzl's _compile_one).
  #
  # compile_commands.json feeds clangd, so a silently mangled argument list
  # surfaces as phantom IDE diagnostics with no build-side signal at all -
  # the worst possible failure shape. Since the split cannot be made
  # correct, it is made LOUD: a token carrying an unbalanced quote is the
  # observable fingerprint of a mis-split argument, and fails the generator
  # rather than writing a database that lies.
  inner = value[1:-1]
  if not inner:
    return []
  tokens = [item.strip() for item in inner.split(", ")]
  for token in tokens:
    if token.count("\"") % 2 != 0 or token.count("'") % 2 != 0:
      fail(
        ("compdb: cannot faithfully recover this cxx_compile command from aquery's rendered text - " +
         "token {!r} has an unbalanced quote, which means an argument containing \", \" was split. " +
         "Rendered command: {}").format(token, value),
      )
  return tokens

def _source_from_identifier(value: str) -> str:
  prefix = "source="
  if not value.startswith(prefix) or ";" not in value:
    fail("cxx_compile action is missing structured source metadata: {}".format(value))
  source = value[len(prefix):].split(";", 1)[0]
  if not source or source.startswith("/") or ".." in source.split("/"):
    fail("invalid structured cxx_compile source metadata: {}".format(value))
  return source

def _impl(ctx: bxl.Context):
  targets = ctx.uquery().eval("//cpp/... + //python/...")
  actions = ctx.aquery().all_actions(targets)
  root = ctx.root()
  entries = []
  for action in actions:
    info = action.attrs
    if info.category.value() != "cxx_compile":
      continue
    cmd = _parse_rendered_list(info.cmd.value())
    source = _source_from_identifier(info.identifier.value())
    file_path = "{}/{}".format(root, source)
    entries.append({
      "directory": root,
      "file": file_path,
      "arguments": cmd,
    })
  entries = sorted(entries, key = lambda entry: entry["file"])
  output = ctx.bxl_actions().actions.write_json("compile_commands.json", entries, pretty = True)
  ensured = ctx.output.ensure(output)
  ctx.output.print(ensured)

compdb = bxl_main(
  impl = _impl,
  cli_args = {},
)
