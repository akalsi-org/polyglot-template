# go/BUCK now holds only lane-wide lint targets (gofmt_check/go_vet scan the
# whole lane); the buildable/testable targets moved to per-component BUCK
# files - go/lib/greeting/BUCK, go/app/hello/BUCK, go/test/BUCK - mirroring
# the cpp lane's existing per-component shape. gofmt_check/go_vet reach every
# source across those package boundaries via `deps=` (go_binary/go_test now
# also emit GoInfo - see rules/go.bzl), since glob(["**/*.go"]) from this
# package can no longer see files that moved into a nested package's own
# BUCK-file boundary.
load("//rules:go.bzl", "go_graph_check", "go_lint")

go_lint(
  name = "gofmt_check",
  mode = "fmt",
  deps = [
    "//go/app/hello:hello",
    "//go/app/hello:main_test",
    "//go/lib/greeting:greeting",
    "//go/test:greeting_test",
  ],
)

go_lint(
  name = "go_vet",
  mode = "vet",
  packages = ["./go/..."],
  deps = [
    "//go/app/hello:hello",
    "//go/app/hello:main_test",
    "//go/lib/greeting:greeting",
    "//go/test:greeting_test",
  ],
)

# Drift check: every in-module .go file that `go list -deps -test ./go/...`
# resolves must already be declared by one of the lane's go_* targets. This
# is the Go counterpart of the ts/tsweb lanes' deno_graph_check - see
# rules/go.bzl's go_graph_check for why a package-pattern toolchain makes
# this check load-bearing rather than merely tidy. Scoped lane-wide (not
# per-component) precisely because the pattern is: a file undeclared by
# EVERY target is the failure being caught.
go_graph_check(
  name = "graph_check",
  packages = ["./go/..."],
  deps = [
    "//go/app/hello:hello",
    "//go/app/hello:main_test",
    "//go/lib/greeting:greeting",
    "//go/test:greeting_test",
  ],
)
