# go/BUCK now holds only lane-wide lint targets (gofmt_check/go_vet scan the
# whole lane); the buildable/testable targets moved to per-component BUCK
# files - go/lib/greeting/BUCK, go/app/hello/BUCK, go/test/BUCK - mirroring
# the cpp lane's existing per-component shape. gofmt_check/go_vet reach every
# source across those package boundaries via `deps=` (go_binary/go_test now
# also emit GoInfo - see rules/go.bzl), since glob(["**/*.go"]) from this
# package can no longer see files that moved into a nested package's own
# BUCK-file boundary.
load("//rules:go.bzl", "go_lint")

go_lint(
  name = "gofmt_check",
  mode = "fmt",
  deps = [
    "//go/app/hello:hello",
    "//go/app/hello:main_test",
    "//go/lib/greeting:greeting",
    "//go/test:greeting_test",
  ],
)

go_lint(
  name = "go_vet",
  mode = "vet",
  packages = ["./go/..."],
  deps = [
    "//go/app/hello:hello",
    "//go/app/hello:main_test",
    "//go/lib/greeting:greeting",
    "//go/test:greeting_test",
  ],
)
