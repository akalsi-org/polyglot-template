# This package owns lane-wide Go formatting, vet, and graph checks.
# Component BUCK files own buildable and testable targets.
load("//rules:go.bzl", "go_graph_check", "go_lint")

_GO_LANE_DEPS = [
  "//go/app/hello:hello",
  "//go/app/hello:main_test",
  "//go/bench/filewin:bench_filewin",
  "//go/bench/filewin:bench_filewin_test",
  "//go/bench/mpsc:bench_queue",
  "//go/bench/mpsc:bench_queue_test",
  "//go/bench/mpsc:run_campaign",
  "//go/bench/mpsc:run_campaign_test",
  "//go/bench/mpsc:schema_test",
  "//go/bench/mpsc:summarize_campaign",
  "//go/bench/mpsc:summarize_campaign_test",
  "//go/lib/atmc:atmc",
  "//go/lib/atmc:atmc_test",
  "//go/lib/filewin:filewin",
  "//go/lib/filewin:filewin_test",
  "//go/lib/greeting:greeting",
  "//go/lib/hostcpu:hostcpu",
  "//go/lib/hostcpu:hostcpu_test",
  "//go/lib/internal/orderedatomic:orderedatomic",
  "//go/lib/internal/orderedatomic:orderedatomic_test",
  "//go/lib/internal/shmregion:shmregion",
  "//go/lib/internal/shmregion:shmregion_test",
  "//go/lib/uring:uring",
  "//go/lib/uring:uring_test",
  "//go/lib/journal:journal",
  "//go/lib/journal:journal_test",
  "//go/lib/mpsc:mpsc",
  "//go/lib/mpsc:mpsc_test",
  "//go/lib/unsafeborrow:unsafeborrow",
  "//go/lib/unsafeborrow:unsafeborrow_test",
  "//go/test:greeting_test",
]

go_lint(
  name = "gofmt_check",
  mode = "fmt",
  deps = _GO_LANE_DEPS,
)

go_lint(
  name = "go_vet",
  mode = "vet",
  packages = ["./go/..."],
  deps = _GO_LANE_DEPS,
)

# This check compares each resolved package graph with its declared GoInfo closure.
# It also rejects in-module Go files that no target declares.
go_graph_check(
  name = "graph_check",
  packages = ["./go/..."],
  deps = _GO_LANE_DEPS,
)
