# ts/BUCK now holds ONLY lane-wide fmt_check/lint targets; the buildable/
# testable targets moved to per-component BUCK files - ts/lib/greeting/BUCK,
# ts/app/hello/BUCK, ts/app/server/BUCK, ts/test/BUCK - mirroring the cpp
# lane's existing per-component shape. `deps=` folds every component's
# DenoSourcesInfo into the staged tree deno fmt/lint walk (see
# rules/deno.bzl's DenoSourcesInfo doc comment) - no more hand-written
# _SRCS path dict or cross-package export_file() re-exports.

load("//rules:deno.bzl", "deno_lint")

_TS_DEPS = [
  "//ts/app/hello:hello",
  "//ts/app/server:server",
  "//ts/lib/greeting:greeting",
  "//ts/test:test_srcs",
]

# ts-lint parity: `deno fmt --check` and `deno lint`, scoped to ts/ (deno.json's
# fmt/lint "include" already covers both ts/ and tsweb/, so each lane checks
# only its own subtree here to keep the two lint targets independent).
deno_lint(
  name = "fmt_check",
  args = ["fmt", "--check"],
  entries = ["ts/"],
  deps = _TS_DEPS,
  visibility = ["PUBLIC"],
)

deno_lint(
  name = "lint",
  args = ["lint"],
  entries = ["ts/"],
  deps = _TS_DEPS,
  visibility = ["PUBLIC"],
)
