load("//rules:deno.bzl", "deno_app", "deno_check")

deno_app(
  name = "server",
  main = "main.ts",
  srcs = ["main.ts"],
  deps = ["//ts/lib/greeting:greeting"],
  visibility = ["PUBLIC"],
)

# ts-build parity, this app's slice: `deno check --frozen ts/app/server/main.ts`.
# entries derives from :server's own DenoAppInfo (see rules/deno.bzl's
# _resolve_entries) - the entrypoint path is declared once, at deno_app
# itself, not restated here.
deno_check(
  name = "check",
  deps = [":server"],
  visibility = ["PUBLIC"],
)
