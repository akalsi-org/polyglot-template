# tsweb/BUCK keeps the shared/lane-wide targets: deno_cache (the one
# network-permitted population action shared by both the ts/ and tsweb/
# lanes - deno cache resolves the whole graph in one pass, so it deliberately
# stays out of any single per-component BUCK file), vite_build's "site"
# target (kept here rather than moved into tsweb/app/site/BUCK: it is a
# lane-level build product name - //tsweb:site - that //packages:polyglot-demo
# and repo.sh's tsweb-build both already reference, and vite.config.ts itself
# lives at this package's own top level, not under app/site/), the tsweb-test
# smoke check, lane-wide fmt/lint, and tsconfig/prettier emission. The
# buildable/testable component targets moved to per-component BUCK files -
# tsweb/lib/app/BUCK, tsweb/lib/title/BUCK, tsweb/app/site/BUCK,
# tsweb/test/BUCK - mirroring the cpp lane's existing per-component shape.

load("//rules:deno.bzl", "deno_cache", "deno_lint", "smoke_test", "tsconfig_drift_test", "tsconfig_emit", "vite_build")

# vite.config.ts lives directly in this package, so it needs no export_file()
# wrapper the way a cross-package reference would - it's referenced straight
# via `srcs` below, same as any other same-package attrs.source().
_VITE_CONFIG_SRCS = {"tsweb/vite.config.ts": "vite.config.ts"}

_ALL_DEPS = [
  "//ts/app/hello:hello",
  "//ts/app/server:server",
  "//ts/lib/greeting:greeting",
  "//ts/test:test_srcs",
  "//tsweb/app/site:site",
  "//tsweb/lib/app:app",
  "//tsweb/lib/title:title",
  "//tsweb/test:test_srcs",
]

# The one network-permitted action for both the ts/ and tsweb/ lanes. deps
# fold every component's DenoSourcesInfo into the staged tree (see
# rules/deno.bzl's DenoSourcesInfo doc comment) - `entries` stays a small
# explicit list of representative entrypoints (deno cache only needs to walk
# far enough to resolve every REMOTE/npm dependency; local file imports never
# require pre-caching - see rules/deno.bzl's module docstring).
deno_cache(
  name = "cache",
  entries = [
    "ts/app/hello/main.ts",
    "ts/test/greeting_test.ts",
    "tsweb/app/site/main.tsx",
    "tsweb/test/app_test.tsx",
    "tsweb/test/title_test.ts",
    "tsweb/vite.config.ts",
  ],
  deps = _ALL_DEPS,
  srcs = _VITE_CONFIG_SRCS,
  visibility = ["PUBLIC"],
)

# tsweb-build parity: `deno run --cached-only --frozen -A npm:vite@8.1.4
# build --config tsweb/vite.config.ts`. vite.config.ts's outDir resolves
# "../build/tsweb/site" relative to itself, i.e. <staged-root>/build/tsweb/site.
vite_build(
  name = "site",
  config = "tsweb/vite.config.ts",
  out_dir = "build/tsweb/site",
  vite_version = "8.1.4",
  deps = [
    "//tsweb/app/site:site",
    "//tsweb/lib/app:app",
    "//tsweb/lib/title:title",
  ],
  srcs = _VITE_CONFIG_SRCS,
  visibility = ["PUBLIC"],
)

# tsweb-test parity, part 2: python3 tools/tsweb_smoke.py --root <site>.
smoke_test(
  name = "smoke",
  root = ":site",
  script = "//:tsweb_smoke.py",
  visibility = ["PUBLIC"],
)

# tsweb-lint parity: `deno fmt --check` and `deno lint`, scoped to tsweb/.
deno_lint(
  name = "fmt_check",
  args = ["fmt", "--check"],
  entries = ["tsweb/"],
  deps = [
    "//tsweb/app/site:site",
    "//tsweb/lib/app:app",
    "//tsweb/lib/title:title",
    "//tsweb/test:test_srcs",
  ],
  srcs = _VITE_CONFIG_SRCS,
  visibility = ["PUBLIC"],
)

deno_lint(
  name = "lint",
  args = ["lint"],
  entries = ["tsweb/"],
  deps = [
    "//tsweb/app/site:site",
    "//tsweb/lib/app:app",
    "//tsweb/lib/title:title",
    "//tsweb/test:test_srcs",
  ],
  srcs = _VITE_CONFIG_SRCS,
  visibility = ["PUBLIC"],
)

# tsconfig/prettier emission (deferred where-it-finally-lives decision; see
# rules/deno.bzl doc comment). Materialize with:
#   ./repo.sh exec buck2 build //tsweb:tsconfig --show-full-output
tsconfig_emit(
  name = "tsconfig",
  deno_json = "//:deno.json",
  visibility = ["PUBLIC"],
)

tsconfig_drift_test(
  name = "tsconfig_drift",
  deno_json = "//:deno.json",
  visibility = ["PUBLIC"],
)
