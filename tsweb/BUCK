# tsweb/BUCK keeps this lane's lane-wide targets: vite_build's "site"
# target (kept here rather than moved into tsweb/app/site/BUCK: it is a
# lane-level build product name - //tsweb:site - that //packages:polyglot-demo
# and repo.sh's tsweb-build both already reference, and vite.config.ts itself
# lives at this package's own top level, not under app/site/), the tsweb-test
# smoke check, lane-wide fmt/lint, and tsconfig/prettier emission. The
# buildable/testable component targets live in per-component BUCK files -
# tsweb/lib/app/BUCK, tsweb/lib/title/BUCK, tsweb/app/site/BUCK,
# tsweb/test/BUCK - mirroring the cpp lane's per-component shape. The
# shared ts+tsweb deno_cache population action lives at //:deno-cache (root
# BUCK): it is cross-lane infrastructure, not a tsweb feature, and its
# coverage of every deno component is guarded fail-closed by repo.sh lint's
# deno-cache-coverage check.

load("//rules:deno.bzl", "deno_lint", "smoke_test", "tsconfig_drift_test", "tsconfig_emit", "vite_build")
load("//rules:file.bzl", "export_file")

# vite.config.ts lives directly in this package; the export_file exists so
# //:deno-cache (root BUCK) can stage it across the package boundary. Same-
# package consumers below still reference it straight via `srcs`.
export_file(
  name = "vite.config.ts",
  src = "vite.config.ts",
  visibility = ["PUBLIC"],
)

_VITE_CONFIG_SRCS = {"tsweb/vite.config.ts": "vite.config.ts"}

# This lane's three site components - shared by site/fmt_check/lint below so
# the list exists exactly once.
_SITE_DEPS = [
  "//tsweb/app/site:site",
  "//tsweb/lib/app:app",
  "//tsweb/lib/title:title",
]

# tsweb-build parity: `deno run --cached-only --frozen -A npm:vite@8.1.4
# build --config tsweb/vite.config.ts`. vite.config.ts's outDir resolves
# "../build/tsweb/site" relative to itself, i.e. <staged-root>/build/tsweb/site.
vite_build(
  name = "site",
  config = "tsweb/vite.config.ts",
  out_dir = "build/tsweb/site",
  vite_version = "8.1.4",
  deps = _SITE_DEPS,
  srcs = _VITE_CONFIG_SRCS,
  visibility = ["PUBLIC"],
)

# tsweb-test parity, part 2: python3 tools/tsweb_smoke.py --root <site>.
smoke_test(
  name = "smoke",
  root = ":site",
  script = "//:tsweb_smoke.py",
  visibility = ["PUBLIC"],
)

# tsweb-lint parity: `deno fmt --check` and `deno lint`, scoped to tsweb/.
deno_lint(
  name = "fmt_check",
  args = ["fmt", "--check"],
  entries = ["tsweb/"],
  deps = _SITE_DEPS + ["//tsweb/test:test_srcs"],
  srcs = _VITE_CONFIG_SRCS,
  visibility = ["PUBLIC"],
)

deno_lint(
  name = "lint",
  args = ["lint"],
  entries = ["tsweb/"],
  deps = _SITE_DEPS + ["//tsweb/test:test_srcs"],
  srcs = _VITE_CONFIG_SRCS,
  visibility = ["PUBLIC"],
)

# tsconfig/prettier emission (deferred where-it-finally-lives decision; see
# rules/deno.bzl doc comment). Materialize with:
#   ./repo.sh exec buck2 build //tsweb:tsconfig --show-full-output
tsconfig_emit(
  name = "tsconfig",
  deno_json = "//:deno.json",
  visibility = ["PUBLIC"],
)

tsconfig_drift_test(
  name = "tsconfig_drift",
  deno_json = "//:deno.json",
  visibility = ["PUBLIC"],
)
