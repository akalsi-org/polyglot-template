# Hand-declared mirror of the moon-owned python lane's python/lib packages:
# example (pure python) and fastbytes (the pinned-ABI C++ extension built by
# tools/python_build.py under the moon lane). See rules/python.bzl for the
# py_library / py_extension rule semantics.

load("//rules:python.bzl", "py_extension", "py_library")

py_library(
  name = "example",
  root = "python/lib",
  srcs = ["example/example.py"],
  visibility = ["PUBLIC"],
)

py_extension(
  name = "fastbytes",
  package = "fastbytes",
  srcs = ["fastbytes/fastbytes.cc"],
  init_src = "fastbytes/__init__.py",
  visibility = ["PUBLIC"],
)
