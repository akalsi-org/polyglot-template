# python/lib's own package-level sources: modules that live directly under
# python/lib rather than in one of its nested packages (python/lib/example,
# python/lib/fastbytes, each with its own BUCK file and therefore its own
# buck2 package boundary - a glob here could not see them anyway).
#
# test_helpers is imported by python/test/test_helpers_test.py and by
# tools/py_test_runner.py's own TestContext import, but belonged to no
# target's srcs at all: the pinned interpreter resolved it off the live
# PYTHONPATH tree while buck2 tracked nothing, so editing it invalidated
# nothing and `./repo.sh coverage` kept serving a cached report. Declaring it
# here is what makes every consuming action depend on it for real - and
# python/test:compileall's declared-vs-resolved assertion (see
# rules/python.bzl) now fails closed if another such file appears.

load("//rules:python.bzl", "py_library")

py_library(
  name = "test_helpers",
  root = "python/lib",
  srcs = ["test_helpers.py"],
  visibility = ["PUBLIC"],
)
