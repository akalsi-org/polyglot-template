{
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "[go]": {
    "editor.detectIndentation": false,
    "editor.insertSpaces": false,
    "editor.tabSize": 2
  },
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}"
  ],
  "deno.enable": true,
  "deno.enablePaths": [
    "./ts",
    "./tsweb"
  ],
  "deno.config": "./deno.json",
  "deno.cache": "./.local/cache/deno",
  "go.alternateTools": {
    "go": "${workspaceFolder}/.vscode/go"
  },
  "go.toolsEnvVars": {
    "CGO_ENABLED": "0",
    "GOEXPERIMENT": "jsonv2",
    "GOTOOLCHAIN": "local"
  },
  "python.analysis.extraPaths": [
    "${workspaceFolder}/python/lib",
    "${workspaceFolder}/python/app"
  ],
  "python.defaultInterpreterPath": "${workspaceFolder}/.local/bin/python",
  "python.envFile": "${workspaceFolder}/.vscode/python.env",
  "python.terminal.useEnvFile": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": true,
  "python.testing.unittestArgs": [
    "-s",
    "python/test",
    "-p",
    "test_*.py"
  ],
  "files.watcherExclude": {
    "**/.local/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "**/.local": true,
    "**/build": true,
    "**/dist": true,
    "**/__pycache__": true
  },
  "deno.path": "./.local/bin/deno",
  "deno.lint": true,
  "buck2-lsp-adapter.buck2Path": "${workspaceFolder}/.local/bin/buck2"
}
