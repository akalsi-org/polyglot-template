{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/polyglot-template/native-adapter-fragment.schema.json",
  "title": "Native dependency adapter action fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter", "actions"],
  "properties": {
    "schema_version": { "const": 1 },
    "adapter": { "type": "string", "minLength": 1 },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "output", "arguments"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "output": { "type": "string", "minLength": 1 },
          "arguments": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
